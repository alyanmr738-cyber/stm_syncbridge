# Copy to .env.local. DO NOT COMMIT secrets.

APP_ENV=development
APP_BASE_URL=http://localhost:3000
BUSINESS_TIMEZONE=

# Fail-closed feature gates (string "true" only enables; absent = false)
SYNC_ENABLED=false
OUTBOUND_WRITES_ENABLED=false
CUSTOMER_MESSAGING_ENABLED=false
HISTORICAL_IMPORT_ENABLED=false
BOOKING_SYNC_ENABLED=false
JOB_COMPLETION_SYNC_ENABLED=false
ESTIMATE_SYNC_ENABLED=false
INVOICE_SYNC_ENABLED=false
AI_SUMMARY_SYNC_ENABLED=false
REVIEW_TRIGGER_ENABLED=false
EMERGENCY_AUTO_BOOK_ENABLED=false

# Scheduling policy (minutes) — independent until business confirms defaults
MIN_BOOKING_LEAD_TIME_MINUTES=
VISIT_BUFFER_MINUTES=
TRAVEL_TIME_ALLOWANCE_MINUTES=

JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_OAUTH_CALLBACK_URL=
JOBBER_GRAPHQL_VERSION=2026-11-03
JOBBER_ALLOWED_ACCOUNT_IDS=

GHL_LOCATION_ID=
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_ALLOWED_LOCATION_IDS=
GHL_REVIEW_WORKFLOW_INBOUND_URL=
GHL_WEBHOOK_SECRET=
GHL_WEBHOOK_PUBLIC_KEY=

# Record-scoped pilot. Does not enable Gate A. Prefer typed lists.
PILOT_ENTITY_IDS=
PILOT_JOBBER_CLIENT_IDS=
PILOT_JOBBER_JOB_IDS=
PILOT_GHL_CONTACT_IDS=
PILOT_GHL_OPPORTUNITY_IDS=
# Comma list. Empty + Gate A off = jobberClientId only. Never set identity fields for the first live pilot.
PILOT_GHL_ALLOWED_FIELDS=jobberClientId
# Default on when Gate A is off. Set false only if creating records is explicitly approved.
PILOT_EXISTING_RECORDS_ONLY=true
# Explicitly required to create contacts/jobs/opportunities. Gate A alone does not enable creates.
ALLOW_RECORD_CREATION=false
# Optional per-test: JOB_COMPLETION_SYNC_ENABLED / ESTIMATE_SYNC_ENABLED / AI_SUMMARY_SYNC_ENABLED
# stay false until a named PILOT record test is approved.
CRON_SECRET=

SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
TOKEN_ENCRYPTION_KEY_BASE64=

QUEUE_PROVIDER=postgres
INTERNAL_ACTION_SIGNING_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_EMAIL_ALLOWLIST=you@allaccessdigital.example
ADMIN_BOOTSTRAP_PASSWORD=

# Optional: mock mode when providers unset (default true in development)
USE_PROVIDER_MOCKS=true
